<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Version>6.2.1</Version>
    <PackageId>HallerErne.OpenProtocolInterpreter</PackageId>
    <Description>Bidirectional serializer/deserializer for Atlas Copco Open Protocol MID messages. Forked from Rickedb/OpenProtocolInterpreter with Rexroth/NEXO vendor-specific MID extensions.</Description>
    <Copyright>Copyright © 2026 Haller + Erne GmbH</Copyright>
    <Authors>Haller + Erne GmbH</Authors>
    <Company>Haller + Erne GmbH</Company>
    <PackageProjectUrl>https://github.com/hallererne/OpenProtocolInterpreter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hallererne/OpenProtocolInterpreter</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>CSharp Open Protocol Atlas Copco Rexroth NEXO</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReleaseNotes>See release notes at: https://github.com/hallererne/OpenProtocolInterpreter/releases/tag/6.2.1. Added ToString() overrides to TighteningErrorStatus and TighteningErrorStatus2 listing set error bits (e.g. "TighteningErrorStatus2 { DriveHot, SnugMax }").</PackageReleaseNotes>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DocumentationFile>bin\release\OpenProtocolInterpreter.xml</DocumentationFile>
    <OutputPath></OutputPath>
    <NoWarn>1701;1702;1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Properties\**" />
    <EmbeddedResource Remove="Properties\**" />
    <None Remove="Properties\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\media\icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>
</Project>
